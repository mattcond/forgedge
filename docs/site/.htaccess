# Force http -> https. Without this, http://forgedge.it/ stays a live,
# separately crawlable URL and Google has to resolve the http/https
# duplicate itself via the canonical tag (which it does correctly --
# see the "Duplicate, Google chose different canonical" report entry
# for the http URL -- but a redirect removes the duplicate at the
# source instead of leaving it to be reconciled after the fact).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Force UTF-8 regardless of the shared-hosting server's own default
# charset (OVH's Apache commonly defaults text/html to ISO-8859-1 via
# AddDefaultCharset, which overrides the page's own <meta charset="UTF-8">
# per HTTP-header precedence and garbles accented letters, em dashes,
# arrows, and the ≥/≠ symbols used throughout these pages).
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType 'text/html; charset=UTF-8' .html
  AddType 'text/css; charset=UTF-8' .css
  # Force these explicitly too -- generic shared-hosting mime.types
  # configs sometimes lack .xml/.txt entries entirely, which makes
  # Apache fall back to application/octet-stream. A sitemap served as
  # a binary/unknown type is exactly what makes Google Search Console
  # report "couldn't fetch" / "unsupported format" for a file whose
  # content is perfectly valid XML.
  AddType 'application/xml; charset=UTF-8' .xml
  AddType 'text/plain; charset=UTF-8' .txt
</IfModule>
